# 依赖
node_modules/
.venv/
venv/
env/
__pycache__/
*.pyc

# 构建产物 / 安装包
dist/
out/
build/
*.dmg
*.exe
subagent.dmg
subagent-setup.exe

# ⚠️ 0.4.11 例外：build/ 下的【打包配置与脚本】必须纳入版本控制。
# 此前 `build/` 被整目录忽略 → vetarai-sidecar.spec 与两个打包脚本都不在 git 里，
# 冻结包 Office 缺陷的修复（spec 内的 collect_data_files 参数）只存在于磁盘，
# **重新 clone 仓库即丢失**，且 SOP 里的 venv 路径错误也无人能从历史发现。
# 下面用否定规则精确放行"源文件"，仍忽略 1.8GB 级的构建产物。
!build/
build/*
!build/*.sh
!build/*.spec
!build/*.js
!build/*.icns
!build/*.iconset/
# ⚠️ 0.4.20 新增例外：entitlements plist 是**签名的源文件**（不是构建产物），
#   漏了它 sign_app.sh 会进 git 而它依赖的两个 plist 不会 → 换环境重新构建
#   必然报「⛔ 缺少 build/entitlements-main.plist」。与上面 0.4.11 那次
#   「build/ 被整目录忽略导致 spec 丢失」是**同一类事故**，故一并放行。
!build/*.plist
# 构建产物仍忽略（.app 目录 / dist / work / 历史 DMG）
build/VetarAI.app/
build/dist/
build/work/
build/build/
build/*.dmg

# 日志 / 缓存 / 系统文件
*.log
logs/
.DS_Store

# 编辑器 / 测试产物
*.local
.pytest_cache/
.coverage
